---
import Icon from './Icon.astro';
import { SURGERY_CATEGORIES } from '../data/surgeries';

interface Props {
  /** "overlay" = transparent over the homepage hero; "solid" = white sticky bar for every other page */
  variant?: 'overlay' | 'solid';
  active?: 'about' | 'blog';
  /** The blog design omits the LINE button in its nav; every other page has it. */
  showCta?: boolean;
  /** ms before the Surgeries mega-menu closes after mouseleave (blog design: 800, others: 1000) */
  closeDelay?: number;
  /** category/procedure designs render category names with white-space:pre-line in the sub-panel header */
  preLine?: boolean;
}

const { variant = 'solid', active, showCta = true, closeDelay = 1000, preLine = false } = Astro.props;
const overlay = variant === 'overlay';

const linkStyle = (key?: 'about' | 'blog') =>
  'font-weight:600; font-size:15px;' + (overlay ? '' : ` color:${active === key && key ? 'var(--accent)' : '#122a3a'};`);
---

<nav
  class:list={[{ 'nav-overlay': overlay }]}
  style={overlay
    ? 'position:relative; z-index:5; display:flex; align-items:center; justify-content:space-between; gap:24px; padding:26px clamp(24px,5vw,72px); max-width:1320px; width:100%; margin:0 auto;'
    : 'background:#fff; border-bottom:1px solid #e1edf3; position:sticky; top:0; z-index:40;'}
>
  <div
    style={overlay
      ? 'display:contents;'
      : 'max-width:1320px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:24px; padding:18px clamp(20px,5vw,72px);'}
  >
    <a href="/" style="display:flex; align-items:center;">
      {overlay ? (
        <img src="/assets/aria-logo-white-trim.png" alt="Ariacorporation" style="height:30px; width:auto; display:block;" />
      ) : (
        <img src="/assets/aria-logo-navy-trim.png" alt="Ariacorporation" style="height:28px; width:auto; display:block;" />
      )}
    </a>
    <div style={`display:flex; align-items:center; gap:${overlay ? 38 : 32}px;${overlay ? ' color:#fff;' : ''}`}>
      <a href="/about/" class="navlink" style={linkStyle('about')}>会社概要</a>
      <div class="nav-surg" data-close-delay={closeDelay}>
        <a
          href="/#surgeries"
          class="navlink"
          style={`display:inline-flex; align-items:center; gap:5px; ${linkStyle()}`}
        >施術一覧 <Icon name="chevron-down" style="font-size:16px;" /></a>
        <div class="surg-mega">
          <div class="surg-mega-inner">
            {SURGERY_CATEGORIES.map((c) => (
              <div class="surg-cat">
                <a href={`/surgeries/${c.slug}/`} class="surg-cat-row">
                  <span>{c.name}</span>
                  <Icon name="chevron-right" class="chev" style="font-size:16px;" />
                </a>
                <div class="surg-sub">
                  <div class="surg-sub-inner">
                    <a
                      href={`/surgeries/${c.slug}/`}
                      style="display:flex; align-items:center; justify-content:space-between; gap:14px; padding:0 11px 12px; margin-bottom:6px; border-bottom:1px solid #eef4f7;"
                    >
                      <span
                        style={`font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:15px; color:#122a3a;${preLine ? ' white-space:pre-line;' : ''}`}
                      >{c.name}</span>
                      <span style="display:inline-flex; align-items:center; gap:5px; font-size:12.5px; font-weight:700; color:var(--accent); white-space:nowrap;">概要を見る <Icon name="arrow-up-right" style="font-size:14px;" /></span>
                    </a>
                    {c.procedures.map((p) => (
                      <a href={`/procedures/${p.slug}/`} class="surg-proc">{p.name}</a>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <a href="/#services" class="navlink" style={linkStyle()}>サービス</a>
      <a href="/#story" class="navlink" style={linkStyle()}>私たちの物語</a>
      <a href="/blog/" class="navlink" style={linkStyle('blog')}>ブログ</a>
      <div class="nav-lang">
        <button type="button" class="lang-btn" aria-label="Change language">
          <svg class="lang-flag" viewBox="0 0 24 16" aria-hidden="true"><rect width="24" height="16" fill="#fff"/><circle cx="12" cy="8" r="4" fill="#BC002D"/></svg>
          <Icon name="chevron-down" class="lang-chev" style="width:15px; height:15px;" />
        </button>
        <div class="lang-menu">
          <a href="#" class="lang-item" data-lang="ko"><svg class="lang-flag" viewBox="0 0 24 16" aria-hidden="true"><rect width="24" height="16" fill="#fff"/><circle cx="12" cy="8" r="3.5" fill="#CD2E3A"/><path d="M12 4.5a3.5 3.5 0 0 0 0 7 1.75 1.75 0 0 0 0-3.5 1.75 1.75 0 0 1 0-3.5z" fill="#0047A0"/></svg> 한국어</a>
          <a href="#" class="lang-item" data-lang="en"><svg class="lang-flag" viewBox="0 0 24 16" aria-hidden="true"><rect width="24" height="16" fill="#fff"/><g fill="#B22234"><rect width="24" height="1.23" y="0"/><rect width="24" height="1.23" y="2.46"/><rect width="24" height="1.23" y="4.92"/><rect width="24" height="1.23" y="7.38"/><rect width="24" height="1.23" y="9.84"/><rect width="24" height="1.23" y="12.3"/><rect width="24" height="1.23" y="14.77"/></g><rect width="10" height="8.6" fill="#3C3B6E"/></svg> English</a>
          <a href="#" class="lang-item" data-lang="zh-cn"><svg class="lang-flag" viewBox="0 0 24 16" aria-hidden="true"><rect width="24" height="16" fill="#DE2910"/><path d="M4.5 3 5.2 5.1 7.4 5.1 5.6 6.4 6.3 8.5 4.5 7.2 2.7 8.5 3.4 6.4 1.6 5.1 3.8 5.1z" fill="#FFDE00"/><circle cx="9" cy="2.4" r=".7" fill="#FFDE00"/><circle cx="10.4" cy="4" r=".7" fill="#FFDE00"/><circle cx="10.4" cy="6.2" r=".7" fill="#FFDE00"/><circle cx="9" cy="7.8" r=".7" fill="#FFDE00"/></svg> 中文（简体）</a>
          <a href="#" class="lang-item" data-lang="zh-tw"><svg class="lang-flag" viewBox="0 0 24 16" aria-hidden="true"><rect width="24" height="16" fill="#FE0000"/><rect width="12" height="8" fill="#000095"/><circle cx="6" cy="4" r="2.6" fill="#fff"/><circle cx="6" cy="4" r="1.5" fill="#000095"/></svg> 繁體中文</a>
        </div>
      </div>
      {showCta && (
        <a
          href="https://lin.ee/3KJTZXJ"
          style={overlay
            ? 'display:inline-flex; align-items:center; gap:9px; background:var(--accent); color:#fff; font-weight:700; font-size:14.5px; padding:12px 20px; border-radius:999px; box-shadow:0 10px 24px -10px rgba(255,122,77,.8);'
            : 'display:inline-flex; align-items:center; gap:9px; background:var(--accent); color:#fff; font-weight:700; font-size:14.5px; padding:11px 19px; border-radius:999px;'}
        >
          <Icon name="message-circle" style="font-size:17px;" /> LINEで予約
        </a>
      )}
    </div>
  </div>
</nav>

<script>
  // Surgeries mega-menu: open on mouseenter, close after a delay on mouseleave (so the cursor can reach the panel).
  document.querySelectorAll<HTMLElement>('.nav-surg').forEach((el) => {
    const delay = Number(el.dataset.closeDelay) || 1000;
    let timer: number | undefined;
    el.addEventListener('mouseenter', () => {
      clearTimeout(timer);
      el.classList.add('open');
    });
    el.addEventListener('mouseleave', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => el.classList.remove('open'), delay);
    });
  });

  // Language switcher: button toggles; outside click closes.
  document.querySelectorAll<HTMLElement>('.nav-lang').forEach((el) => {
    el.querySelector('.lang-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      el.classList.toggle('open');
    });
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Element | null;
    if (!t?.closest?.('.nav-lang')) {
      document.querySelectorAll('.nav-lang.open').forEach((el) => el.classList.remove('open'));
    }
  });
</script>
