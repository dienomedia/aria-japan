---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { SURGERY_CATEGORIES } from '../../data/surgeries';
import { procedureVals } from '../../lib/procedure';

export function getStaticPaths() {
  return SURGERY_CATEGORIES.flatMap((category) =>
    category.procedures.map((procedure) => ({ params: { slug: procedure.slug }, props: { procedure, category } })),
  );
}

const { procedure, category } = Astro.props;
const vals = procedureVals(procedure, category);
const {
  aboutFigEl,
  aboutGroups,
  aboutParas,
  afCaption,
  afLegend,
  afSideParas,
  benefitGroups,
  cartilageItems,
  caseList,
  catName,
  catSlug,
  compareItems,
  compareTitle,
  dfHeading,
  dfIntro,
  dfItems,
  factAnesthesia,
  factDuration,
  factPrice,
  factPriceNote,
  faqs,
  figureGroups,
  fnExtraHeading,
  fnExtraText,
  fnHeading,
  fnImgEl,
  fnIntro,
  hasAbout,
  hasAboutFigure,
  hasAfMeta,
  hasAfSide,
  hasBenefits,
  hasCartilageGallery,
  hasCases,
  hasCompareFigure,
  hasDualFeature,
  hasFaqs,
  hasFigureGroups,
  hasFigureNote,
  hasFnExtra,
  hasIdealFor,
  hasMethods,
  hasRichFigures,
  hasSeptumFigure,
  hasSiblings,
  hasSplitCompare,
  hasStabilityGraph,
  hasStayNote,
  hasStaySchedule,
  hasStepGallery,
  hasSurgMethods,
  hasTechniques,
  hasTypeGallery,
  hasVsTable,
  heroImgEl,
  heroLabel,
  idealForHeading,
  idealForItems,
  methodRows,
  methodsHeading,
  name,
  noAbout,
  noAfSide,
  noBenefits,
  noFacts,
  noHeroImg,
  richFigures,
  scAgeLeft,
  scAgeRight,
  scCandLeft,
  scCandRight,
  scHeading,
  scImgFullDissection,
  scImgFullIncision,
  scImgMiniDissection,
  scImgMiniIncision,
  scIncisionLeft,
  scIncisionRight,
  scIntro,
  scLeftTitle,
  scLiftLeft,
  scLiftRight,
  scRightTitle,
  septumHeading,
  septumPanels,
  septumPara,
  siblings,
  smHeading,
  smItems,
  stabilityHeading,
  stabilityIntro,
  stabilityPoints,
  stayNote,
  stayRows,
  stepGridClass,
  stepHeading,
  stepIntro,
  stepItems,
  summary,
  techHeading,
  techniques,
  typeGalleryItems,
  vsLeftTitle,
  vsRightTitle,
  vsRows
} = vals;
---

<Base title={`${name.replace(/\n/g, ' ')} | Ariacorporation`} description={summary}>
  <div style="font-family:'Noto Sans JP',system-ui,sans-serif; color:#122a3a; background:#eef6fa; min-height:100vh; -webkit-font-smoothing:antialiased; display:flex; flex-direction:column;">
    <Nav preLine />

  
    <header style="background:linear-gradient(180deg,#eef6fa 0%,#ffffff 100%); border-bottom:1px solid #e1edf3;">
      <div style="max-width:1320px; margin:0 auto; padding:clamp(26px,3.5vw,48px) clamp(20px,5vw,72px) clamp(40px,5vw,60px); display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(32px,4vw,60px); align-items:center;">
        <div>
          <div style="display:flex; align-items:center; gap:9px; font-size:13.5px; font-weight:600; color:#5a7488; margin-bottom:24px; flex-wrap:wrap;">
            <a href="/" style="color:#5a7488;">ホーム</a>
            <Icon name="chevron-right" style="font-size:15px; opacity:.5;" />
            <a href="/#surgeries" style="color:#5a7488;">施術一覧</a>
            <Icon name="chevron-right" style="font-size:15px; opacity:.5;" />
            <a href={`/surgeries/${catSlug}/`} style="color:#5a7488;">{catName}</a>
            <Icon name="chevron-right" style="font-size:15px; opacity:.5;" />
            <span style="color:#122a3a; white-space:pre-line;">{name}</span>
          </div>
          <div style="display:inline-flex; align-items:center; gap:8px; background:#eaf6fa; color:#2e9fc0; font-size:12.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; padding:7px 14px; border-radius:999px; margin-bottom:20px;">
  {catName}
          </div>
          <h1 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(32px,4.4vw,54px); line-height:1.06; letter-spacing:-.02em; margin:0 0 18px;">{name}</h1>
          <p style="font-size:clamp(16px,1.6vw,19px); line-height:1.6; color:#445d6e; max-width:540px; margin:0 0 30px; white-space:pre-line;">{summary}</p>
          <div style="display:flex; flex-wrap:wrap; gap:13px;">
            <a href="https://lin.ee/3KJTZXJ" style="display:inline-flex; align-items:center; gap:10px; background:var(--accent); color:#fff; font-weight:700; font-size:16px; padding:15px 26px; border-radius:13px; box-shadow:0 16px 34px -16px rgba(255,122,77,.85);">
              <Icon name="message-circle" style="font-size:19px;" /> この手術について問い合わせる
            </a>
            <a href={`/surgeries/${catSlug}/`} style="display:inline-flex; align-items:center; gap:9px; border:1.5px solid #cfdfe7; color:#122a3a; font-weight:700; font-size:16px; padding:15px 24px; border-radius:13px;">
              {catName}をすべて見る <Icon name="arrow-right" style="font-size:18px;" />
            </a>
          </div>
        </div>
        <div class="ph" style="aspect-ratio:4/3.2; border-radius:24px; min-height:300px; box-shadow:0 30px 60px -30px rgba(16,41,61,.4);"><Fragment set:html={heroImgEl} />{noHeroImg && (<><span class="ph-l">{heroLabel}</span></>)}</div>
      </div>
    </header>

  
    <main style="flex:1; max-width:1320px; width:100%; margin:0 auto; padding:clamp(40px,5vw,72px) clamp(20px,5vw,72px) clamp(56px,7vw,96px); display:grid; grid-template-columns:minmax(0,1fr) minmax(0,340px); gap:clamp(32px,4vw,56px); align-items:start;">

    
      <article>
        <section style="margin-bottom:44px;">
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(24px,2.6vw,30px); line-height:1.18; letter-spacing:-.01em; margin:0 0 16px;">この手術について</h2>
          {hasAbout && (<>
            <div style="display:flex; flex-direction:column; gap:16px;">
              {aboutParas.map((para) => (<>
                <p style="font-size:16.5px; line-height:1.75; color:#445d6e; margin:0; white-space:pre-line;">{para.text}</p>
              </>))}
            </div>
            {aboutGroups.map((grp) => (<>
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,21px); line-height:1.25; letter-spacing:-.01em; margin:30px 0 12px; white-space:pre-line;">{grp.heading}</h3>
              <div style="display:flex; flex-direction:column; gap:14px;">
                {grp.paras.map((para) => (<>
                  <p style="font-size:16.5px; line-height:1.75; color:#445d6e; margin:0; white-space:pre-line;">{para.text}</p>
                </>))}
              </div>
              {grp.hasImages && (<>
                <div style="display:flex; flex-direction:column; gap:clamp(16px,2vw,22px); margin-top:22px;">
                  {grp.images.map((im) => (<>
                    <Fragment set:html={im.el} />
                  </>))}
                </div>
              </>)}
            </>))}
            {hasAboutFigure && (<>
              <figure style="margin:28px 0 0;">
                {hasAfSide && (<>
                  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:clamp(22px,3vw,40px); align-items:center;">
                    <div style="border-radius:18px; overflow:hidden; border:1px solid #e1edf3; background:#fff;">
                      <Fragment set:html={aboutFigEl} />
                    </div>
                    <div style="display:flex; flex-direction:column; gap:16px;">
                      {afSideParas.map((sp) => (<>
                        <p style="font-size:16px; line-height:1.72; color:#445d6e; margin:0; white-space:pre-line;">{sp.text}</p>
                      </>))}
                    </div>
                  </div>
                </>)}
                {noAfSide && (<>
                <div style="border-radius:18px; overflow:hidden; border:1px solid #e1edf3; background:#fbfcfd;">
                  <Fragment set:html={aboutFigEl} />
                </div>
                {hasAfMeta && (<>
                <figcaption style="margin-top:16px;">
                  <div style="display:flex; flex-wrap:wrap; gap:12px 26px; margin-bottom:12px;">
                    {afLegend.map((lg) => (<>
                      <span style="display:inline-flex; align-items:center; gap:9px; font-size:14.5px; font-weight:600; color:#122a3a;">
                        <span style={`width:15px; height:15px; border-radius:4px; flex:none; background:${lg.color}; box-shadow:0 0 0 1px rgba(16,41,61,.12);`}></span>{lg.label}
                      </span>
                    </>))}
                  </div>
                  <p style="font-size:14.5px; line-height:1.6; color:#5a7488; margin:0; white-space:pre-line;">{afCaption}</p>
                </figcaption>
                </>)}
                </>)}
              </figure>
            </>)}
            {hasMethods && (<>
              <div style="margin-top:38px;">
                <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(20px,2.3vw,26px); line-height:1.2; letter-spacing:-.01em; margin:0 0 26px; color:#122a3a; white-space:pre-line;">{methodsHeading}</h3>
                <div style="display:flex; flex-direction:column; gap:clamp(26px,3.4vw,42px);">
                  {methodRows.map((mr) => (<>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:clamp(22px,3vw,40px); align-items:center;">
                      <div style="border-radius:16px; overflow:hidden; border:1px solid #e6edf2; background:#fff;">
                        <Fragment set:html={mr.imgEl} />
                      </div>
                      <div>
                        <h4 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,22px); line-height:1.25; letter-spacing:-.01em; margin:0 0 14px; color:#122a3a; white-space:pre-line;">{mr.title}</h4>
                        <div style="height:2px; background:#122a3a; width:100%; margin:0 0 16px;"></div>
                        <p style="font-size:16px; line-height:1.72; color:#445d6e; margin:0; white-space:pre-line;">{mr.text}</p>
                      </div>
                    </div>
                  </>))}
                </div>
              </div>
            </>)}
          </>)}
          {noAbout && (<>
            <p style="font-size:16.5px; line-height:1.75; color:#445d6e; margin:0 0 16px;">{summary} 詳細な内容は現在準備中です。最終ページでは、施術方法や適応対象、予想される結果、プラン全体での位置づけなどを、韓国での治療を検討する海外患者様向けに詳しくご説明します。</p>
            <p style="font-size:16.5px; line-height:1.75; color:#445d6e; margin:0;">滞在中は、カウンセリング・手術・通訳・フォローアップケアまで、アリアコーポレーションがすべてを調整し、全行程をシンプルで透明なものに保ちます。</p>
          </>)}
          {hasIdealFor && (<>
            <div style="margin-top:30px;">
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,22px); line-height:1.25; letter-spacing:-.01em; margin:0 0 16px; color:#122a3a; white-space:pre-line;">{idealForHeading}</h3>
              <div style="display:flex; flex-direction:column; gap:13px;">
                {idealForItems.map((it) => (<>
                  <div style="display:flex; gap:14px; align-items:flex-start;">
                    <Icon name="circle-check" style="font-size:21px; color:#2e9fc0; flex:none; margin-top:1px;" />
                    <p style="font-size:16px; line-height:1.6; color:#445d6e; margin:0; white-space:pre-line;">{it.text}</p>
                  </div>
                </>))}
              </div>
            </div>
          </>)}
          {hasTypeGallery && (<>
            <div style="margin-top:34px;">
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,22px); line-height:1.25; letter-spacing:-.01em; margin:0 0 20px; color:#122a3a;">鼻整形で効果が出やすい4つの鼻のタイプ</h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(155px,1fr)); gap:clamp(14px,2vw,22px);">
                {typeGalleryItems.map((ti) => (<>
                  <div style="display:flex; flex-direction:column;">
                    <div style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(30px,3.2vw,40px); color:#cdd9e1; line-height:1; letter-spacing:-.02em; white-space:pre-line;">{ti.num}</div>
                    <div style="font-size:15.5px; font-weight:700; color:#122a3a; margin:9px 0 13px; white-space:pre-line;">{ti.label}</div>
                    <Fragment set:html={ti.imgEl} />
                  </div>
                </>))}
              </div>
            </div>
          </>)}
          {hasCartilageGallery && (<>
            <div style="margin-top:38px;">
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,22px); line-height:1.3; letter-spacing:-.01em; margin:0 0 22px; color:#122a3a;">インプラントを使わない鼻整形で使用される軟骨の種類</h3>
              <div class="cartilage-grid">
                {cartilageItems.map((ca) => (<>
                  <div style="display:flex; flex-direction:column;">
                    <Fragment set:html={ca.imgEl} />
                    <p style="font-size:16px; font-weight:700; color:#122a3a; line-height:1.35; margin:15px 0 7px; white-space:pre-line;">{ca.label}</p>
                    <p style="font-size:14.5px; line-height:1.62; color:#5a7488; margin:0; white-space:pre-line;">{ca.desc}</p>
                  </div>
                </>))}
              </div>
            </div>
          </>)}
          {hasSeptumFigure && (<>
            <div style="margin-top:38px; background:#f7fbfd; border:1px solid #e1edf3; border-radius:20px; padding:clamp(22px,3vw,32px);">
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,22px); line-height:1.3; letter-spacing:-.01em; margin:0 0 14px; color:#122a3a; white-space:pre-line;">{septumHeading}</h3>
              <p style="font-size:16px; line-height:1.72; color:#445d6e; margin:0; white-space:pre-line;">{septumPara}</p>
              <div style="margin-top:26px; display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:clamp(18px,2.5vw,30px);">
                {septumPanels.map((sp) => (<>
                  <div style="display:flex; flex-direction:column; align-items:center; text-align:center;">
                    <p style="font-size:16px; font-weight:700; color:#122a3a; line-height:1.35; margin:0; white-space:pre-line;">{sp.title}</p>
                    <p style="font-size:14px; color:#5a7488; line-height:1.45; margin:5px 0 16px; white-space:pre-line;">{sp.sub}</p>
                    <Fragment set:html={sp.imgEl} />
                    <p style="font-size:14.5px; font-weight:600; color:#3f6075; margin:14px 0 0; white-space:pre-line;">{sp.caption}</p>
                  </div>
                </>))}
              </div>
            </div>
          </>)}
          {hasStabilityGraph && (<>
            <div style="margin-top:38px;">
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(20px,2.3vw,25px); line-height:1.25; letter-spacing:-.01em; margin:0 0 12px; color:#122a3a; white-space:pre-line;">{stabilityHeading}</h3>
              <p style="font-size:16.5px; line-height:1.7; color:#445d6e; margin:0 0 22px; white-space:pre-line;">{stabilityIntro}</p>
              <div style="background:linear-gradient(180deg,#fcfbf8,#fbfdfe); border:1px solid #e7eef2; border-radius:20px; padding:clamp(14px,2.4vw,26px);">
                <svg viewBox="0 0 1150 540" style="width:100%; height:auto; display:block; font-family:'Noto Sans JP',sans-serif;" role="img" aria-label="Tissue stability over time after rhinoplasty">
                  <defs>
                    <linearGradient id="rvLine" x1="0" y1="0" x2="1" y2="0">
                      <stop offset="0" stop-color="#3b82f6"></stop>
                      <stop offset="1" stop-color="#4fd1c5"></stop>
                    </linearGradient>
                    <linearGradient id="rvArea" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#3b82f6" stop-opacity="0.18"></stop>
                      <stop offset="1" stop-color="#3b82f6" stop-opacity="0"></stop>
                    </linearGradient>
                  </defs>
                
                  <rect x="655" y="60" width="190" height="320" fill="#3b82f6" opacity="0.07"></rect>
                
                  <path d="M100,360 C121.7,357.5 171.7,357 230,345 C288.3,333 379.2,311.3 450,288 C520.8,264.7 589.2,233 655,205 C720.8,177 785.5,142.2 845,120 L845,380 L100,380 Z" fill="url(#rvArea)"></path>
                
                  <line x1="70" y1="380" x2="1012" y2="380" stroke="#c9d4db" stroke-width="2.5"></line>
                  <path d="M1012,380 L998,373 M1012,380 L998,387" stroke="#c9d4db" stroke-width="2.5" fill="none" stroke-linecap="round"></path>
                
                  <line x1="230" y1="345" x2="230" y2="380" stroke="#9cc3f5" stroke-width="2"></line>
                  <line x1="450" y1="288" x2="450" y2="380" stroke="#9cc3f5" stroke-width="2"></line>
                  <line x1="655" y1="205" x2="655" y2="380" stroke="#6aa8f0" stroke-width="2.5"></line>
                  <line x1="845" y1="120" x2="845" y2="380" stroke="#6aa8f0" stroke-width="2.5"></line>
                
                  <path d="M100,360 C121.7,357.5 171.7,357 230,345 C288.3,333 379.2,311.3 450,288 C520.8,264.7 589.2,233 655,205 C720.8,177 785.5,142.2 845,120 C904.5,97.8 984.2,80 1012,72" fill="none" stroke="url(#rvLine)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M1012,72 L995,71 M1012,72 L1004,87" stroke="#4fd1c5" stroke-width="5" fill="none" stroke-linecap="round"></path>
                
                  <path d="M690,232 l34,20 l-34,20 M724,232 l34,20 l-34,20" fill="none" stroke="#3b82f6" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" opacity="0.35"></path>
                
                  <circle cx="100" cy="360" r="9" fill="#3b82f6"></circle>
                  <circle cx="230" cy="345" r="10" fill="#ffffff" stroke="#3b82f6" stroke-width="4"></circle>
                  <circle cx="450" cy="288" r="9" fill="#3b82f6"></circle>
                  <circle cx="655" cy="205" r="10" fill="#3b82f6"></circle>
                  <circle cx="845" cy="120" r="11" fill="#3b82f6"></circle>
                
                  <path d="M905,70 l22,40 l-44,0 Z" fill="none" stroke="#122a3a" stroke-width="3.5" stroke-linejoin="round"></path>
                  <line x1="905" y1="84" x2="905" y2="96" stroke="#122a3a" stroke-width="3.5" stroke-linecap="round"></line>
                  <circle cx="905" cy="103" r="1.8" fill="#122a3a"></circle>
                  <text x="872" y="148" font-family="'Zen Kaku Gothic New',sans-serif" font-weight="700" font-size="25" fill="#122a3a">推奨される</text>
                  <text x="872" y="180" font-family="'Zen Kaku Gothic New',sans-serif" font-weight="700" font-size="25" fill="#122a3a">再手術の時期：</text>
                  <text x="872" y="212" font-size="23" fill="#445d6e">最低6カ月以降</text>
                
                  <text x="230" y="428" text-anchor="middle" font-family="'Zen Kaku Gothic New',sans-serif" font-weight="700" font-size="27" fill="#122a3a">1カ月後</text>
                  <text x="450" y="428" text-anchor="middle" font-family="'Zen Kaku Gothic New',sans-serif" font-weight="700" font-size="27" fill="#122a3a">3カ月後</text>
                  <text x="655" y="428" text-anchor="middle" font-family="'Zen Kaku Gothic New',sans-serif" font-weight="700" font-size="27" fill="#122a3a">6カ月後</text>
                  <text x="845" y="428" text-anchor="middle" font-family="'Zen Kaku Gothic New',sans-serif" font-weight="700" font-size="27" fill="#122a3a">1年後</text>
                  <text x="230" y="468" text-anchor="middle" font-size="22" fill="#5a7488">［組織の安定度］</text>
                  <text x="450" y="468" text-anchor="middle" font-size="22" fill="#5a7488">［組織の安定度］</text>
                  <text x="655" y="468" text-anchor="middle" font-size="22" fill="#5a7488">［組織の安定度］</text>
                  <text x="845" y="468" text-anchor="middle" font-size="22" fill="#5a7488">［組織の安定度］</text>
                </svg>
              </div>
              <div style="margin-top:22px; display:flex; flex-direction:column; gap:13px;">
                {stabilityPoints.map((pt) => (<>
                  <div style="display:flex; gap:12px; align-items:flex-start;">
                    <span style="flex:none; width:7px; height:7px; border-radius:50%; background:var(--accent); margin-top:9px;"></span>
                    <p style="font-size:16px; line-height:1.65; color:#445d6e; margin:0; white-space:pre-line;">{pt.text}</p>
                  </div>
                </>))}
              </div>
            </div>
          </>)}
          {hasCompareFigure && (<>
            <div style="margin-top:32px; background:#f7fbfd; border:1px solid #e1edf3; border-radius:20px; padding:clamp(22px,3vw,32px);">
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,22px); line-height:1.2; letter-spacing:-.01em; margin:0 0 22px; color:#122a3a; white-space:pre-line;">{compareTitle}</h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:clamp(18px,2.5vw,28px);">
                {compareItems.map((ci) => (<>
                  <div style="display:flex; flex-direction:column;">
                    <Fragment set:html={ci.imgEl} />
