            <div style="display:grid; grid-template-columns:minmax(0,1fr) clamp(96px,11vw,132px) minmax(0,1fr);">
              <div style="padding:18px 16px; text-align:center; font-size:14.5px; line-height:1.6; color:#445d6e; align-self:center; white-space:pre-line;">{scCandLeft}</div>
              <div style="display:flex; align-items:center; justify-content:center; text-align:center; padding:12px 6px; font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(12.5px,1.4vw,15px); line-height:1.25; color:#33506a; background:#fafdfe; border-left:1px solid #eef3f6; border-right:1px solid #eef3f6;">適応対象</div>
              <div style="padding:18px 16px; text-align:center; font-size:14.5px; line-height:1.6; color:#445d6e; align-self:center; white-space:pre-line;">{scCandRight}</div>
            </div>

          </div>
        </section>
        </>)}

        {hasSurgMethods && (<>
        <section style="margin-bottom:44px;">
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(22px,2.4vw,28px); line-height:1.2; letter-spacing:-.01em; margin:0 0 26px;">{smHeading}</h2>
          <div style="display:flex; flex-direction:column; gap:clamp(30px,4vw,48px);">
            {smItems.map((m) => (<>
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(290px,1fr)); gap:clamp(24px,3vw,42px); align-items:start;">
                <div style="border-radius:18px; overflow:hidden; border:1px solid #e6edf2; background:#fff; white-space:pre-line;"><Fragment set:html={m.imgEl} /></div>
                <div>
                  <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(19px,2.1vw,23px); line-height:1.25; letter-spacing:-.01em; margin:0 0 14px; color:#122a3a; white-space:pre-line;">{m.title}</h3>
                  <div style="height:2px; background:#122a3a; width:100%; margin:0 0 18px;"></div>
                  {m.paras.map((para) => (<>
                    <p style="font-size:16px; line-height:1.72; color:#445d6e; margin:0 0 14px; white-space:pre-line;">{para.text}</p>
                  </>))}
                  {m.groups.map((g) => (<>
                    <div style="margin-top:18px;">
                      <div style={`font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:14px; letter-spacing:.02em; text-transform:uppercase; color:${g.color}; margin:0 0 12px; white-space:pre-line;`}>{g.label}</div>
                      <div style="display:flex; flex-direction:column; gap:10px;">
                        {g.items.map((it) => (<>
                          <div style="display:flex; gap:11px; align-items:flex-start;">
                            <Icon name={g.iconName} style={`font-size:20px; color:${g.iconColor}; flex:none; margin-top:1px;`} />
                            <p style="font-size:15.5px; line-height:1.6; color:#445d6e; margin:0; white-space:pre-line;">{it.text}</p>
                          </div>
                        </>))}
                      </div>
                    </div>
                  </>))}
                </div>
              </div>
            </>))}
          </div>
        </section>
        </>)}

        <section style="margin-bottom:44px;">
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(22px,2.4vw,28px); line-height:1.18; letter-spacing:-.01em; margin:0 0 16px;">メリット</h2>
          {hasBenefits && (<>
            <div style="display:flex; flex-direction:column; gap:30px;">
              {benefitGroups.map((g) => (<>
                <div>
                  {g.title && (<>
                  <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(17px,1.9vw,20px); line-height:1.25; margin:0 0 14px; white-space:pre-line;">{g.title}</h3>
                  </>)}
                  <div style="display:flex; flex-direction:column; gap:14px;">
                    {g.items.map((b) => (<>
                      <div style="display:flex; gap:14px; align-items:flex-start;">
                        <Icon name="circle-check" style="font-size:22px; color:#2e9fc0; flex:none; margin-top:1px;" />
                        <p style="font-size:16px; line-height:1.65; color:#445d6e; margin:0; white-space:pre-line;">{b.text}</p>
                      </div>
                    </>))}
                  </div>
                </div>
              </>))}
            </div>
          </>)}
          {noBenefits && (<>
            <div style="display:flex; flex-direction:column; gap:14px;">
              <div style="display:flex; gap:14px; align-items:flex-start;">
                <Icon name="circle-check" style="font-size:22px; color:#2e9fc0; flex:none; margin-top:1px;" />
                <p style="font-size:16px; line-height:1.65; color:#445d6e; margin:0;">写真での診断を含む詳細なカウンセリングと、誠実なご提案。 <span style="color:#9aabb6;">（仮）</span></p>
              </div>
              <div style="display:flex; gap:14px; align-items:flex-start;">
                <Icon name="circle-check" style="font-size:22px; color:#2e9fc0; flex:none; margin-top:1px;" />
                <p style="font-size:16px; line-height:1.65; color:#445d6e; margin:0;">ご契約前の、隠れた費用のない明瞭なお見積もり。 <span style="color:#9aabb6;">（仮）</span></p>
              </div>
              <div style="display:flex; gap:14px; align-items:flex-start;">
                <Icon name="circle-check" style="font-size:22px; color:#2e9fc0; flex:none; margin-top:1px;" />
                <p style="font-size:16px; line-height:1.65; color:#445d6e; margin:0;">回復に合わせた通訳・送迎・術後ケアの手配。 <span style="color:#9aabb6;">（仮）</span></p>
              </div>
            </div>
          </>)}
        </section>

      
        {hasSiblings && (<>
        <section>
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(20px,2.2vw,24px); line-height:1.2; letter-spacing:-.01em; margin:0 0 18px;">関連施術</h2>
          <div style="display:flex; flex-wrap:wrap; gap:11px;">
            {siblings.map((s) => (<>
              <a href={`/procedures/${s.slug}/`} class="sib">{s.name} <Icon name="arrow-right" style="font-size:15px;" /></a>
            </>))}
          </div>
        </section>
        </>)}
      </article>

    
      <aside style="position:sticky; top:96px; background:#fff; border:1px solid #e1edf3; border-radius:22px; padding:26px 26px 24px; box-shadow:0 1px 2px rgba(16,41,61,.04);">
        <div style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:18px; margin:0 0 18px;">基本情報</div>
        <div style="display:flex; flex-direction:column; gap:0;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:14px; padding:13px 0; border-bottom:1px solid #eef4f7;">
            <span style="display:inline-flex; align-items:center; gap:9px; font-size:14px; color:#5a7488; font-weight:500;"><Icon name="clock" style="font-size:17px; color:#2e9fc0;" /> 施術時間</span>
            <span style="font-size:14px; font-weight:600; color:#122a3a; text-align:right; white-space:pre-line;">{factDuration}</span>
          </div>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:14px; padding:13px 0; border-bottom:1px solid #eef4f7;">
            <span style="display:inline-flex; align-items:center; gap:9px; font-size:14px; color:#5a7488; font-weight:500;"><Icon name="moon" style="font-size:17px; color:#2e9fc0;" /> 麻酙</span>
            <span style="font-size:14px; font-weight:600; color:#122a3a; text-align:right; white-space:pre-line;">{factAnesthesia}</span>
          </div>
          <div style="padding:13px 0; border-bottom:1px solid #eef4f7;">
            <span style="display:inline-flex; align-items:center; gap:9px; font-size:14px; color:#5a7488; font-weight:500; margin-bottom:10px;"><Icon name="calendar" style="font-size:17px; color:#2e9fc0;" /> 韓国滞在に必要な日数</span>
            {hasStaySchedule && (<>
              <div style="display:flex; flex-direction:column; gap:7px; margin-top:4px;">
                {stayRows.map((s) => (<>
                  <div style="display:flex; align-items:baseline; gap:10px;">
                    <span style="flex:none; min-width:46px; font-size:12px; font-weight:700; color:var(--accent); letter-spacing:.02em; white-space:pre-line;">{s.day}</span>
                    <span style="font-size:13.5px; font-weight:600; color:#122a3a; white-space:pre-line;">{s.label}</span>
                  </div>
                </>))}
              </div>
            </>)}
            {hasStayNote && (<>
              <div style="margin-top:11px; font-size:12px; line-height:1.55; color:#5a7488; font-style:italic;">* {stayNote}</div>
            </>)}
          </div>
          <div style="padding:13px 0;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:14px;">
              <span style="display:inline-flex; align-items:center; gap:9px; font-size:14px; color:#5a7488; font-weight:500;"><Icon name="banknote" style="font-size:17px; color:#2e9fc0;" /> 価格帯</span>
              <span style="font-size:14px; font-weight:700; color:#122a3a; text-align:right; white-space:pre-line;">{factPrice}</span>
            </div>
            {factPriceNote && (<>
              <div style="margin-top:6px; text-align:right; font-size:12px; color:#9aabb6; font-style:italic; white-space:pre-line;">{factPriceNote}</div>
            </>)}
          </div>
        </div>
        {noFacts && (<>
          <div style="font:600 10.5px/1.5 ui-monospace,Menlo,monospace; letter-spacing:.1em; color:#b6c4cd; text-transform:uppercase; margin-top:16px; text-align:center;">詳細は確認中です</div>
        </>)}
        <a href="https://lin.ee/3KJTZXJ" style="display:flex; align-items:center; justify-content:center; gap:9px; margin-top:18px; background:var(--accent); color:#fff; font-weight:700; font-size:15px; padding:14px 20px; border-radius:12px;">
          <Icon name="message-circle" style="font-size:18px;" /> 見積もりを取る
        </a>
      </aside>
    </main>

  
    <Footer variant="back" backHref={`/surgeries/${catSlug}/`} backLabel={`${catName}に戻る`} />

  </div>

</Base>
