---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { excerpt, formatDate, getPublishedPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | Ariacorporation`} description={excerpt(post.body)}>
  <div style="font-family:'Noto Sans JP',system-ui,sans-serif; color:#122a3a; background:#eef6fa; min-height:100vh; -webkit-font-smoothing:antialiased; display:flex; flex-direction:column;">
    <Nav active="blog" showCta={false} closeDelay={800} />

    <main style="flex:1; display:flex; justify-content:center; padding:clamp(16px,4vh,56px) 18px;">
      <article style="width:100%; max-width:760px; align-self:flex-start; background:#fff; border-radius:24px; overflow:hidden; box-shadow:0 50px 100px -30px rgba(8,22,33,.6);">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px 20px; border-bottom:1px solid #eef4f7;">
          <a href="/blog/" style="display:inline-flex; align-items:center; gap:7px; font:inherit; font-weight:600; font-size:14px; color:#3f6075; background:#fff; border:1px solid #e1edf3; border-radius:11px; padding:9px 15px;"><Icon name="arrow-left" style="font-size:16px;" /> 一覧に戻る</a>
        </div>
        {post.data.cover && <img src={post.data.cover} alt="" style="width:100%; max-height:360px; object-fit:cover; display:block;" />}
        <div style="padding:clamp(28px,4vw,48px);">
          <div style="display:flex; align-items:center; gap:11px; margin-bottom:18px;">
            <span style="font-size:12px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#2e9fc0;">{post.data.category}</span>
            <span style="font-size:13px; color:#9aabb6;">{formatDate(post.data.date)}</span>
          </div>
          <h1 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(28px,3.6vw,40px); line-height:1.12; letter-spacing:-.02em; margin:0 0 26px;">{post.data.title}</h1>
          <div class="post-body">
            <Content />
          </div>
        </div>
      </article>
    </main>

    <Footer variant="blog" />
  </div>
</Base>
