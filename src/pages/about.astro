---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Base title="会社概要 | Ariacorporation">
  <div style="font-family:'Noto Sans JP',system-ui,sans-serif; color:#122a3a; background:#eef6fa; min-height:100vh; -webkit-font-smoothing:antialiased; display:flex; flex-direction:column;">
    <Nav active="about" />

  
    <header style="background:linear-gradient(180deg,#eef6fa 0%,#ffffff 100%); border-bottom:1px solid #e1edf3;">
      <div style="max-width:1000px; margin:0 auto; padding:clamp(48px,7vw,104px) clamp(20px,5vw,72px);">
        <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#2e9fc0; margin-bottom:18px;">アリアコーポレーションについて</div>
        <h1 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(34px,5vw,62px); line-height:1.05; letter-spacing:-.02em; margin:0 0 28px; max-width:880px;">韓国への旅をご一緒に、信頼できるパートナー</h1>
        <p style="font-size:clamp(17px,1.7vw,21px); line-height:1.7; color:#445d6e; margin:0 0 20px; max-width:760px;">私のキャリアは韓国での俳優活動から始まり、多くの韓国ドラマに出演する中で韓国の美容や韓国文化への深い理解を得ました。この経験を通じて自然と海外の友人たちとつながり、グローバル観光産業に深く関わるようになりました。この道のりが、メディカルツーリズム専門エージェンシーであるAria Corporationの設立につながりました。</p>
        <p style="font-size:clamp(16px,1.5vw,18px); line-height:1.7; color:#445d6e; margin:0 0 20px; max-width:720px;">韓国のトップクラスクリニックを訪れる海外患者様のために、通訳・移動サポート・予約調整・観光を含む全体的なサポートで、海外での不安を取り除くことに尽力しています。</p>
        <p style="font-size:clamp(16px,1.5vw,18px); line-height:1.7; color:#5a7488; margin:0; max-width:720px;">政府認可のメディカルコンシェルジュとして、患者様の安全、透明で合理的な価格、専任体制の継続的なケアをすべての中心に据えています。</p>
      </div>
    </header>

  
    <main style="flex:1;">
      <section style="background:#f7fbfd; border-bottom:1px solid #e1edf3;">
        <div style="max-width:1180px; margin:0 auto; padding:clamp(48px,6vw,96px) clamp(20px,5vw,72px);">
          <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#2e9fc0; margin-bottom:14px;">政府認可エージェンシー</div>
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(28px,3.4vw,44px); line-height:1.1; letter-spacing:-.02em; margin:0 0 16px; max-width:760px;">すべての患者様を支える、2つの公式ライセンス</h2>
          <p style="font-size:clamp(16px,1.5vw,18px); line-height:1.7; color:#5a7488; margin:0 0 clamp(36px,4vw,56px); max-width:680px;">Aria Corporationは、患者様を保護し、韓国のトップクラスのクリニックと直接連携できる2つの政府ライセンスを保有しています。</p>

          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(28px,3vw,44px);">
          
            <div style="background:#fff; border:1px solid #e1edf3; border-radius:24px; overflow:hidden; box-shadow:0 24px 50px -34px rgba(16,41,61,.4);">
              <div style="aspect-ratio:4/3; background:#f1f6f9; display:flex; align-items:center; justify-content:center; padding:18px;"><img src="/assets/license-international-patients.png" alt="외국인환자 유치업자 등록증 — Licensed for Attracting International Patients" style="max-width:100%; max-height:100%; object-fit:contain; border-radius:6px; box-shadow:0 8px 24px -12px rgba(16,41,61,.35);"></div>
              <div style="padding:clamp(24px,3vw,34px);">
                <div style="display:inline-flex; align-items:center; gap:7px; background:#fff1eb; color:var(--accent); font-weight:700; font-size:12px; letter-spacing:.04em; text-transform:uppercase; padding:6px 12px; border-radius:999px; margin-bottom:16px;"><Icon name="shield-check" style="font-size:15px;" /> 患者保護</div>
                <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(20px,2.2vw,25px); line-height:1.2; margin:0 0 14px;">外国人患者誘致業者登録証（国際患者誘致ライセンス）</h3>
                <p style="font-size:15.5px; line-height:1.7; color:#445d6e; margin:0;">これは、韓国で美容整形手術を希望する海外患者様に専門的に対応するために最も重要なライセンスです。認可エージェンシーであることにより、万一医療事故が発生した場合でも、患者様は最大、1億ウォンまでの保険適用を受けられます。さらに、このライセンスにより当社は患者様の公式代理人として、韓国のクリニックとの安全で円滑なコミュニケーション・交渉を代行できます。</p>
              </div>
            </div>

          
            <div style="background:#fff; border:1px solid #e1edf3; border-radius:24px; overflow:hidden; box-shadow:0 24px 50px -34px rgba(16,41,61,.4);">
              <div style="aspect-ratio:4/3; background:#f1f6f9; display:flex; align-items:center; justify-content:center; padding:18px;"><img src="/assets/license-culture-arts.png" alt="대중문화예술기획업 등록증 — Licensed for Public Culture & Arts Planning" style="max-width:100%; max-height:100%; object-fit:contain; border-radius:6px; box-shadow:0 8px 24px -12px rgba(16,41,61,.35);"></div>
              <div style="padding:clamp(24px,3vw,34px);">
                <div style="display:inline-flex; align-items:center; gap:7px; background:#fff1eb; color:var(--accent); font-weight:700; font-size:12px; letter-spacing:.04em; text-transform:uppercase; padding:6px 12px; border-radius:999px; margin-bottom:16px;"><Icon name="star" style="font-size:15px;" /> 芸能人・インフルエンサーネットワーク</div>
                <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(20px,2.2vw,25px); line-height:1.2; margin:0 0 14px;">大衆文化芸術企画業登録証（公行文化芸術企画業ライセンス）</h3>
                <p style="font-size:15.5px; line-height:1.7; color:#445d6e; margin:0;">このライセンスは、芸能人など公人を起用したプロモーション活動を行う際に不可欠です。元芸能人であるCEOの広いネットワークを活かし、提携クリニックのための芸能人タイアップやインフルエンサーマーケティングキャンペーンを積極的に展開しています。この結果、Aria Corporationはクライアント様のために特別な特典やプレミアムサービスを交渉できる強力なパートナーとしての地位を確立しています。</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section style="background:#fff; border-bottom:1px solid #e1edf3;">
        <div style="max-width:1180px; margin:0 auto; padding:clamp(48px,6vw,96px) clamp(20px,5vw,72px); display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(36px,4vw,64px); align-items:start;">
        
          <div style="position:sticky; top:96px;">
            <div class="ph" style="aspect-ratio:4/4.6; border-radius:24px; min-height:360px; box-shadow:0 30px 60px -30px rgba(16,41,61,.4); background:#0e2738;"><img src="/assets/ceo-cha-soonhyung.png" alt="Cha Soon-hyung — Founder & CEO" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 20%;"></div>
          </div>
        
          <div>
            <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#2e9fc0; margin-bottom:14px;">创業者・CEO</div>
            <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(30px,3.6vw,46px); line-height:1.08; letter-spacing:-.02em; margin:0 0 8px;">Cha SoonHyung</h2>
            <div style="font-size:15px; font-weight:600; color:#5a7488; margin-bottom:26px;">Aria Corporation 創業者・CEO</div>

            <p style="font-size:17px; line-height:1.75; color:#445d6e; margin:0 0 18px;">チャ・スンヒョンはAria Corporationを設立する前、「ミスターサンシャイン」「一々は名を向ける」「信者」「神の一手」「パイド・パイパー」「モンスター」などの人気映画・ドラマに出演し、韓国俳優として確たるキャリアを築きました。俳優活動の後、国際マーケティングプロダクション会社を設立し、aespa、ATEEZ、TWICEなどトップクラスK-POPアーティストのグローバルプロモーションプロジェクトを手がけました。</p>
            <p style="font-size:17px; line-height:1.75; color:#445d6e; margin:0 0 18px;">このキャリアを通じて彼は、外見や自信、こまやかなケアが人の人生をどれほど変えうるか、そして本当に信頼できる人に導いてもらうことがどれほど重要かを、自らの経験として学びました。</p>
            <p style="font-size:17px; line-height:1.75; color:#445d6e; margin:0 0 32px;">彼はその同じレベルの専門性と丁寧なケアを海外患者様にも届けるため、Aria Corporationを立ち上げました。私たちは患者様の安全を最優先すること、最も合理的な価格をご提供すること、そして韓国滞在中は常に専任スタッフが寄り添うこと、この3つの柱を大切にしています。ご到着から完全な回復まで、すべての患者様に本当に大切にされていると感じていただけるよう尽力します。</p>

          
            <div style="background:#f7fbfd; border:1px solid #e1edf3; border-radius:22px; padding:clamp(22px,3vw,32px);">
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                <Icon name="clapperboard" style="font-size:20px; color:var(--accent);" />
                <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:20px; margin:0;">スクリーンでの活躍</h3>
              </div>
              <p style="font-size:15px; line-height:1.65; color:#5a7488; margin:0 0 22px;">チャ・スンヒョンの俳優キャリアのハイライト。動画やスクリーンショットは今後追加予定です。</p>

            
              <a href="https://youtu.be/-3dKkcFrytg" target="_blank" rel="noopener" style="position:relative; display:block; aspect-ratio:16/9; border-radius:16px; overflow:hidden; margin-bottom:16px; background:#0e2738;">
                <img src="https://img.youtube.com/vi/-3dKkcFrytg/hqdefault.jpg" alt="Cha Soon-hyung — acting career clip" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
                <span style="position:absolute; inset:0; background:linear-gradient(180deg,rgba(14,39,56,.05),rgba(14,39,56,.45));"></span>
                <span style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">
                  <span style="width:66px; height:66px; border-radius:999px; background:rgba(255,255,255,.92); display:flex; align-items:center; justify-content:center; box-shadow:0 12px 30px -10px rgba(16,41,61,.5);">
                    <Icon name="play" style="font-size:26px; color:var(--accent);" />
                  </span>
                </span>
                <span style="position:absolute; left:14px; bottom:12px; display:inline-flex; align-items:center; gap:6px; font-size:12.5px; font-weight:700; color:#fff; text-shadow:0 1px 4px rgba(0,0,0,.5);"><Icon name="external-link" style="font-size:14px;" /> YouTubeで見る</span>
              </a>

            
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px;">
                <figure style="margin:0; position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#0e2738;">
                  <img src="/assets/still-mr-sunshine.jpg" alt="Mr. Sunshine" loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
                  <figcaption style="position:absolute; left:0; right:0; bottom:0; padding:18px 12px 8px; font-size:12px; font-weight:700; color:#fff; background:linear-gradient(180deg,transparent,rgba(14,39,56,.8));">Mr. Sunshine</figcaption>
                </figure>
                <figure style="margin:0; position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#0e2738;">
                  <img src="/assets/still-monster-1.jpg" alt="Monster" loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
                  <figcaption style="position:absolute; left:0; right:0; bottom:0; padding:18px 12px 8px; font-size:12px; font-weight:700; color:#fff; background:linear-gradient(180deg,transparent,rgba(14,39,56,.8));">Monster</figcaption>
                </figure>
                <figure style="margin:0; position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#0e2738;">
                  <img src="/assets/still-monster-2.jpg" alt="Monster — Chinese-language scene" loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
                  <figcaption style="position:absolute; left:0; right:0; bottom:0; padding:18px 12px 8px; font-size:12px; font-weight:700; color:#fff; background:linear-gradient(180deg,transparent,rgba(14,39,56,.8));">Monster</figcaption>
                </figure>
                <figure style="margin:0; position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#0e2738;">
                  <img src="/assets/still-night-light.jpg" alt="Night Light" loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
                  <figcaption style="position:absolute; left:0; right:0; bottom:0; padding:18px 12px 8px; font-size:12px; font-weight:700; color:#fff; background:linear-gradient(180deg,transparent,rgba(14,39,56,.8));">Night Light</figcaption>
                </figure>
                <figure style="margin:0; position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#0e2738;">
                  <img src="/assets/still-chicago-typewriter.jpg" alt="Chicago Typewriter" loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
                  <figcaption style="position:absolute; left:0; right:0; bottom:0; padding:18px 12px 8px; font-size:12px; font-weight:700; color:#fff; background:linear-gradient(180deg,transparent,rgba(14,39,56,.8));">Chicago Typewriter</figcaption>
                </figure>
                <figure style="margin:0; position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#0e2738;">
                  <img src="/assets/still-pied-piper.jpg" alt="Pied Piper" loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
                  <figcaption style="position:absolute; left:0; right:0; bottom:0; padding:18px 12px 8px; font-size:12px; font-weight:700; color:#fff; background:linear-gradient(180deg,transparent,rgba(14,39,56,.8));">Pied Piper</figcaption>
                </figure>
              </div>
            </div>
          </div>
        </div>
      </section>

    
      <section style="background:#eef6fa; border-top:1px solid #e1edf3;">
        <div style="max-width:980px; margin:0 auto; padding:clamp(48px,6vw,96px) clamp(20px,5vw,72px);">
          <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#2e9fc0; margin-bottom:14px;">会社沿革</div>
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(28px,3.4vw,44px); line-height:1.1; letter-spacing:-.02em; margin:0 0 16px; max-width:680px;">成長の物語</h2>
          <p style="font-size:clamp(16px,1.5vw,18px); line-height:1.7; color:#5a7488; margin:0 0 clamp(40px,5vw,64px); max-width:640px;">韓国のエンターテイメント・マーケティングスタジオから、世界中の患者様にサービスを提供する政府認可メディカルコンシェルジュへ。</p>

          <div style="position:relative; padding-left:8px;">
          
            <div style="position:absolute; left:19px; top:10px; bottom:10px; width:2px; background:#d3e3ec;"></div>

          
            <div style="position:relative; padding-left:56px; padding-bottom:clamp(34px,4vw,48px);">
              <div style="position:absolute; left:8px; top:2px; width:24px; height:24px; border-radius:999px; background:#fff; border:2px solid var(--accent); display:flex; align-items:center; justify-content:center; box-shadow:0 0 0 5px #eef6fa;"><span style="width:8px; height:8px; border-radius:999px; background:var(--accent);"></span></div>
              <div style="display:flex; align-items:baseline; flex-wrap:wrap; gap:10px 14px; margin-bottom:14px;">
                <span style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(24px,3vw,34px); line-height:1; color:#122a3a;">2021</span>
                <span style="display:inline-flex; align-items:center; background:#fff1eb; color:var(--accent); font-weight:700; font-size:12.5px; letter-spacing:.03em; text-transform:uppercase; padding:6px 12px; border-radius:999px;">会社設立</span>
              </div>
              <div style="background:#fff; border:1px solid #e1edf3; border-radius:18px; padding:clamp(22px,3vw,30px); box-shadow:0 18px 40px -32px rgba(16,41,61,.4);">
                <ul style="list-style:none; margin:0; padding:0;">
                  <li style="position:relative; padding-left:18px; margin-bottom:8px; font-size:15.5px; line-height:1.6; color:#2a4456; font-weight:600;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:var(--accent);"></span>有明青・サラムドッル株式会社を設立</li>
                  <li style="position:relative; padding-left:18px; margin-bottom:8px; font-size:15.5px; line-height:1.6; color:#2a4456; font-weight:600;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:var(--accent);"></span>韓国・日本でマーケティング事業を開始</li>
                  <li style="position:relative; padding-left:18px; font-size:15.5px; line-height:1.6; color:#2a4456; font-weight:600;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:var(--accent);"></span>大衆文化芸術企画業として登録</li>
                </ul>
                <div style="margin-top:20px; padding-top:18px; border-top:1px solid #eef4f7;">
                  <div style="font:700 11px/1 'Noto Sans JP'; letter-spacing:.12em; text-transform:uppercase; color:#2e9fc0; margin-bottom:12px;">主な実績</div>
                  <ul style="list-style:none; margin:0; padding:0;">
                    <li style="position:relative; padding-left:18px; margin-bottom:7px; font-size:14.5px; line-height:1.6; color:#5a7488;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:#c0d2dd;"></span>仁川空港国内YouTubeコンテンツ制作（2年間）</li>
                    <li style="position:relative; padding-left:18px; margin-bottom:7px; font-size:14.5px; line-height:1.6; color:#5a7488;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:#c0d2dd;"></span>仁川空港日本・中国SNS運用（2年間）</li>
                    <li style="position:relative; padding-left:18px; margin-bottom:7px; font-size:14.5px; line-height:1.6; color:#5a7488;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:#c0d2dd;"></span>インターパークショッピングのショートフォームマーケティング</li>
                    <li style="position:relative; padding-left:18px; margin-bottom:7px; font-size:14.5px; line-height:1.6; color:#5a7488;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:#c0d2dd;"></span>オキシジンセフティカルズ化粧品の国内マーケティング協力</li>
                    <li style="position:relative; padding-left:18px; margin-bottom:7px; font-size:14.5px; line-height:1.6; color:#5a7488;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:#c0d2dd;"></span>VOGUE JAPAN＆GQ JAPANのコンテンツ制作</li>
                    <li style="position:relative; padding-left:18px; margin-bottom:7px; font-size:14.5px; line-height:1.6; color:#5a7488;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:#c0d2dd;"></span>TWICE、ITZY、ATEEZ、SEVENTEEN、LOONAなどのコンテンツ制作</li>
                    <li style="position:relative; padding-left:18px; font-size:14.5px; line-height:1.6; color:#5a7488;"><span style="position:absolute; left:0; top:9px; width:5px; height:5px; border-radius:999px; background:#c0d2dd;"></span>日本の芸能人・インフルエンサーの日韓ビザサポート・コラボレーション</li>
                  </ul>
                </div>
              </div>
            </div>

          
            <div style="position:relative; padding-left:56px; padding-bottom:clamp(34px,4vw,48px);">
              <div style="position:absolute; left:8px; top:2px; width:24px; height:24px; border-radius:999px; background:#fff; border:2px solid var(--accent); display:flex; align-items:center; justify-content:center; box-shadow:0 0 0 5px #eef6fa;"><span style="width:8px; height:8px; border-radius:999px; background:var(--accent);"></span></div>
