---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { SURGERY_CATEGORIES } from '../../data/surgeries';
import { img } from '../../lib/html';

export function getStaticPaths() {
  return SURGERY_CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

// View-model — port of renderVals() in design-source/surgery-category.dc.html
const { c } = Astro.props;
const name = c.name;
const heroDesc = c.intro ? c.intro : (c.desc + ' This category page is a placeholder — full layout, procedure details, pricing, FAQs and related guides will be added next.');
const introBlocks = (c.introBlocks || []).map((b) => ({ heading: b.heading || '', text: b.text || '', items: (b.items || []).map((t) => ({ text: t })), hasItems: !!(b.items && b.items.length) }));
const hasIntroBlocks = !!(c.introBlocks && c.introBlocks.length);
const noIntroBlocks = !(c.introBlocks && c.introBlocks.length);
const heroLabel = c.shot;
const heroImgEl = c.heroImg ? img(c.heroImg, c.shot || 'Category', { position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: c.heroFit || 'cover', background: '#fff' }) : null;
const hasHeroImg = !!c.heroImg;
const noHeroImg = !c.heroImg;
const heroBoxExtra = c.heroAspect ? ('aspect-ratio:' + c.heroAspect + ';') : 'height:230px;';
const hasDetail = !!(c.detail && c.detail.benefitGroups && c.detail.benefitGroups.length);
const detailBenefitGroups = ((c.detail && c.detail.benefitGroups) || []).map((g) => ({ title: g.title, items: (g.items || []).map((t) => ({ text: t })) }));
const hasRisks = !!(c.detail && c.detail.risks && c.detail.risks.items && c.detail.risks.items.length);
const risksTitle = (c.detail && c.detail.risks && c.detail.risks.title) || '';
const riskItems = ((c.detail && c.detail.risks && c.detail.risks.items) || []).map((t) => ({ text: t }));
const procedures = c.procedures;
---

<Base title={`${name.replace(/\n/g, ' ')} | Ariacorporation`} description={c.desc}>
  <div style="font-family:'Noto Sans JP',system-ui,sans-serif; color:#122a3a; background:#eef6fa; min-height:100vh; -webkit-font-smoothing:antialiased; display:flex; flex-direction:column;">
    <Nav preLine />

  
    <header style="background:linear-gradient(180deg,#eef6fa 0%,#ffffff 100%); border-bottom:1px solid #e1edf3;">
      <div style="max-width:1320px; margin:0 auto; padding:clamp(28px,4vw,52px) clamp(20px,5vw,72px) clamp(40px,5vw,64px);">
        <div style="display:flex; align-items:center; gap:9px; font-size:13.5px; font-weight:600; color:#5a7488; margin-bottom:26px; flex-wrap:wrap;">
          <a href="/" style="color:#5a7488;">ホーム</a>
          <Icon name="chevron-right" style="font-size:15px; opacity:.5;" />
          <a href="/#surgeries" style="color:#5a7488;">施術一覧</a>
          <Icon name="chevron-right" style="font-size:15px; opacity:.5;" />
          <span style="color:#122a3a; white-space:pre-line;">{name}</span>
        </div>

        <div style="display:inline-flex; align-items:center; gap:8px; background:#eaf6fa; color:#2e9fc0; font-size:12.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; padding:7px 14px; border-radius:999px; margin-bottom:20px;">
          施術一覧
        </div>

        <h1 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(34px,5vw,60px); line-height:1.05; letter-spacing:-.02em; margin:0 0 18px; max-width:900px;">{name}</h1>
        {hasIntroBlocks && (<>
          <div style="display:flex; flex-direction:column; gap:22px; max-width:680px;">
            {introBlocks.map((b) => (<>
              <div>
                {b.heading && (<>
                <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(19px,2vw,24px); line-height:1.25; letter-spacing:-.01em; margin:0 0 8px; color:#122a3a;">{b.heading}</h2>
                </>)}
                {b.text && (<>
                <p style="font-size:clamp(16px,1.6vw,18px); line-height:1.65; color:#5a7488; margin:0; white-space:pre-line;">{b.text}</p>
                </>)}
                {b.hasItems && (<>
                  <div style="display:flex; flex-direction:column; gap:11px; margin-top:4px;">
                    {b.items.map((it) => (<>
                      <div style="display:flex; gap:12px; align-items:flex-start;">
                        <Icon name="check" style="font-size:18px; color:#2e9fc0; flex:none; margin-top:3px;" />
                        <p style="font-size:clamp(15px,1.5vw,17px); line-height:1.6; color:#5a7488; margin:0; white-space:pre-line;">{it.text}</p>
                      </div>
                    </>))}
                  </div>
                </>)}
              </div>
            </>))}
          </div>
        </>)}
        {noIntroBlocks && (<>
          <p style="font-size:clamp(16px,1.6vw,19px); line-height:1.6; color:#5a7488; max-width:640px; margin:0; white-space:pre-line;">{heroDesc}</p>
        </>)}
      </div>
    </header>

  
    <main style="flex:1; max-width:1320px; width:100%; margin:0 auto; padding:clamp(40px,5vw,72px) clamp(20px,5vw,72px) clamp(56px,7vw,96px); display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(32px,4vw,56px); align-items:start;">
      {hasDetail && (<>
      <section style="grid-column:1 / -1;">
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(24px,3vw,40px); margin-bottom:clamp(28px,4vw,44px);">
          {detailBenefitGroups.map((g) => (<>
            <div style="background:#fff; border:1px solid #e1edf3; border-radius:20px; padding:clamp(24px,2.6vw,34px); box-shadow:0 1px 2px rgba(16,41,61,.04);">
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,22px); line-height:1.2; letter-spacing:-.01em; margin:0 0 18px; color:#122a3a; white-space:pre-line;">{g.title}</h3>
              <div style="display:flex; flex-direction:column; gap:13px;">
                {g.items.map((it) => (<>
                  <div style="display:flex; gap:12px; align-items:flex-start;">
                    <Icon name="check" style="font-size:19px; color:#2e9fc0; flex:none; margin-top:2px;" />
                    <p style="font-size:15px; line-height:1.55; color:#445d6e; margin:0; white-space:pre-line;">{it.text}</p>
                  </div>
                </>))}
              </div>
            </div>
          </>))}
        </div>
        {hasRisks && (<>
          <div style="background:#fff7f2; border:1px solid #f6d9c8; border-radius:20px; padding:clamp(24px,2.6vw,34px);">
            <h3 style="display:flex; align-items:center; gap:10px; font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(18px,2vw,22px); line-height:1.2; letter-spacing:-.01em; margin:0 0 18px; color:#a84e22;">
              <Icon name="triangle-alert" style="font-size:21px; color:#e07a3e; flex:none;" /> {risksTitle}
            </h3>
            <div style="display:flex; flex-direction:column; gap:13px;">
              {riskItems.map((it) => (<>
                <div style="display:flex; gap:12px; align-items:flex-start;">
                  <span style="flex:none; margin-top:2px; color:#e07a3e; font-size:14px;">⚠️</span>
                  <p style="font-size:15px; line-height:1.55; color:#5a4636; margin:0; white-space:pre-line;">{it.text}</p>
                </div>
              </>))}
            </div>
          </div>
        </>)}
      </section>
      </>)}
      <section>
        <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#2e9fc0; margin-bottom:12px;">このカテゴリーの施術</div>
        <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(24px,2.6vw,32px); line-height:1.15; letter-spacing:-.01em; margin:0 0 8px;">一覧</h2>
        <p style="font-size:15px; line-height:1.6; color:#5a7488; margin:0 0 26px;">各項目はそれぞれの詳細ページにリンクしています。</p>
        <div style="display:flex; flex-direction:column; gap:12px;">
          {procedures.map((p) => (<>
            <a href={`/procedures/${p.slug}/`} class="proc-row">
              <span style="display:flex; align-items:center; gap:14px;">
                <span style="width:8px; height:8px; border-radius:999px; background:var(--accent); flex:none;"></span>
                <span>
                  <span style="display:block; font-weight:600; font-size:16px; color:#122a3a; white-space:pre-line;">{p.name}</span>
                  <span style="display:block; font-size:13.5px; color:#5a7488; margin-top:2px; white-space:pre-line;">{p.summary}</span>
                </span>
              </span>
              <Icon name="arrow-right" style="font-size:18px; color:#9aabb6; flex:none;" />
            </a>
          </>))}
        </div>
      </section>

      <aside style="position:sticky; top:96px;">
        <div style="background:#fff; border:1px solid #e1edf3; border-radius:24px; padding:14px; box-shadow:0 1px 2px rgba(16,41,61,.04);">
          <div class="ph" style={`border-radius:16px; ${heroBoxExtra}`}>{hasHeroImg && (<><Fragment set:html={heroImgEl} /></>)}{noHeroImg && (<><span class="ph-l">{heroLabel}</span></>)}</div>
        </div>
        <a href="https://lin.ee/3KJTZXJ" style="display:flex; align-items:center; justify-content:center; gap:10px; margin-top:16px; background:var(--accent); color:#fff; font-weight:700; font-size:16px; padding:16px 24px; border-radius:14px; box-shadow:0 16px 34px -16px rgba(255,122,77,.85);">
          <Icon name="message-circle" style="font-size:19px;" /> {name}について問い合わせる
        </a>
      </aside>
    </main>

  
    <Footer variant="back" />

  </div>

</Base>
