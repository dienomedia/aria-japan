---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SURGERY_CATEGORIES } from '../data/surgeries';
import { img } from '../lib/html';

const showTrustBar = true;

const stats = [
  { num: '500+',  label: '施術実績' },
  { num: '15+',   label: '提携クリニック' },
  { num: '4.9★',  label: '平均評価' },
  { num: '100%',  label: '日本語対応コンシェルジュ' },
  { num: 'Gov.',  label: '政府認可エージェンシー' },
];

const steps = [
  { no:'01', icon:'message-square-text', title:'ご相談', body:'LINEでご希望と写真数枚をお送りください。無料で率直な診断をいたします。' },
  { no:'02', icon:'clipboard-list',      title:'プラン作成', body:'厳選クリニックとマッチングし、透明な料金を確定させ、旅程を作成します。' },
  { no:'03', icon:'plane-landing',       title:'渡航', body:'空港送迎、ホテルチェックイン、初日から専属通訳が同行します。' },
  { no:'04', icon:'heart-pulse',         title:'回復', body:'術後ケア、フォローアップ、ご帰国まで 24時間サポートします。' },
];

const services = [
  { icon:'plane',          title:'空港出迎え',            body:'仁川空港に到着後、専属ドライバーがすぐにお迎えします。タクシーを探す手間もありません。' },
  { icon:'bed-double',     title:'ホテル手配',         body:'クリニックの近くで、快適かつ術後の回復に適したホテルを手配します。' },
  { icon:'languages',      title:'クリニック予約・通訳', body:'施術のスケジュール調整を行い、すべてのカウンセリングに専門通訳が同行します。' },
  { icon:'car-front',      title:'日々の移動サポート',      body:'ホテル・クリニック・術後管理の往復を専用車で送迎します。' },
  { icon:'heart-pulse',    title:'術後ケアサポート',      body:'滞在中のアフターケアや服薬サポート、回復状況の確認までしっかり寄り添います。' },
  { icon:'message-circle', title:'24時間LINEサポート',     body:'いつでも直接コンシェルジュへ連絡できる、安心の専用窓口です。' },
];

const reviews = [
  { stars:'★★★★★', name:'Emily R.',   country:'アメリカ合衛国', text:'空港から回復まで、アリアがすべて手配してくれました。一瞬たりとも一人だと感じませんでした。' },
  { stars:'★★★★★', name:'Sophie L.',  country:'イギリス', text:'通訳とコンシェルジュのおかげで、鼻の手術の旅はまったくストレスがありませんでした。結果もとても美しいです。' },
  { stars:'★★★★★', name:'Jessica M.', country:'オーストラリア', text:'透明な価格、真心のこもったケア、毎日の確認連絡。遠くから来た価値がありました。' },
];

const blogCats = ['手術ガイド', '回復のヒント', '韓国旅行', '患者様の声'];

const posts = [
  { cat:'手術ガイド', shot:'記事のカバー画像', title:'韓国での鼻整形：2026年完全ガイド', excerpt:'費用、回復期間、鼻の手術に適したクリニックの選び方。' },
  { cat:'回復のヒント',  shot:'記事のカバー画像', title:'回復の最初の1週間に起こること', excerpt:'治癒や腫れの経過を日ごとに解説し、回復を少し楽にするコツをご紹介。' },
  { cat:'韓国旅行',   shot:'記事のカバー画像', title:'術後のソウル散策：無理のない過ごし方', excerpt:'回復スケジュールに合わせて楽しめる、静かなカフェやスパ、散策スポット。' },
];

const badges = [
  { icon:'shield-check', label:'政府認可エージェンシー' },
  { icon:'building-2',   label:'厳選提携クリニック' },
  { icon:'globe',        label:'日本語対応チーム' },
];

const surgeries = SURGERY_CATEGORIES.map((c) => ({
  ...c,
  imgEl: c.heroImg ? img(c.heroImg, c.name || 'Category', { width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'center', display: 'block' }) : null,
}));
---

<Base title="Ariacorporation">
  <div style="font-family:'Noto Sans JP',system-ui,sans-serif; color:#122a3a; background:#eef6fa; -webkit-font-smoothing:antialiased;">
    <section data-screen-label="01 Hero" style="position:relative; min-height:760px; display:flex; flex-direction:column;">
      <div class="ph" style="position:absolute; inset:0; background:#0e2738 url('/assets/hero-bg-street.png') center 45% / cover no-repeat;">
        <div style="position:absolute; inset:0; background:linear-gradient(180deg,rgba(8,22,33,.55) 0%,rgba(8,22,33,.28) 40%,rgba(8,22,33,.78) 100%);"></div>
      </div>

    
      <Nav variant="overlay" />

    
      <div style="position:relative; z-index:4; flex:1; display:flex; align-items:center; max-width:1320px; width:100%; margin:0 auto; padding:0 clamp(24px,5vw,72px) 80px;">
        <div style="max-width:720px; color:#fff;">
          <div style="display:inline-flex; align-items:center; gap:9px; background:rgba(255,255,255,.14); backdrop-filter:blur(6px); border:1px solid rgba(255,255,255,.28); padding:9px 16px; border-radius:999px; font-size:13.5px; font-weight:600; letter-spacing:.01em; margin-bottom:26px;">
            <Icon name="badge-check" style="font-size:17px; color:#ffd2b8;" /> 政府認可メディカルコンシェルジュエージェンシー
          </div>
          <h1 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:800; font-size:clamp(36px,5vw,60px); line-height:1.06; letter-spacing:-.02em; margin:0 0 22px;">
            個人手配より最大40%お得に。韓国での美容整形の旅をトータルサポートします。
          </h1>
          <p style="font-size:clamp(16px,1.5vw,19px); line-height:1.6; color:rgba(255,255,255,.86); max-width:560px; margin:0 0 36px;">
            お問い合わせいただいた瞬間から、最大級の割引に加え、通訳・移動サポート・宿泊手配まで、最も効率的なサービスをご提供します。
          </p>
          <div style="display:flex; flex-wrap:wrap; gap:14px;">
            <a href="https://lin.ee/3KJTZXJ" style="display:inline-flex; align-items:center; gap:10px; background:var(--accent); color:#fff; font-weight:700; font-size:16px; padding:16px 28px; border-radius:14px; box-shadow:0 16px 34px -14px rgba(255,122,77,.85);">
              <Icon name="message-circle" style="font-size:19px;" /> 無料相談を予約する
            </a>
            <a href="#surgeries" style="display:inline-flex; align-items:center; gap:10px; background:rgba(255,255,255,.12); border:1.5px solid rgba(255,255,255,.5); color:#fff; font-weight:700; font-size:16px; padding:16px 28px; border-radius:14px;">
              施術を見る <Icon name="arrow-down" style="font-size:18px;" />
            </a>
          </div>
        </div>
      </div>
    </section>

  
    {showTrustBar && (<>
    <section style="background:#fff; border-bottom:1px solid #e1edf3;">
      <div style="max-width:1320px; margin:0 auto; padding:30px clamp(24px,5vw,72px); display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:28px;">
        {stats.map((s) => (<>
          <div style="display:flex; flex-direction:column; gap:3px; min-width:120px;">
            <div style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:28px; color:#122a3a; letter-spacing:-.01em;">{s.num}</div>
            <div style="font-size:13.5px; font-weight:500; color:#5a7488;">{s.label}</div>
          </div>
        </>))}
      </div>
    </section>
    </>)}

  
    <section style="background:#fff; padding:clamp(64px,8vw,104px) clamp(24px,5vw,72px); border-bottom:1px solid #e1edf3;">
      <div style="max-width:1180px; margin:0 auto;">
        <div style="text-align:center; max-width:720px; margin:0 auto 52px;">
          <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#2e9fc0; margin-bottom:14px;">なぜアリアコーポレーションか</div>
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(30px,3.6vw,44px); line-height:1.1; letter-spacing:-.02em; margin:0 0 14px;">最大40%お得に、しかも旅程まるごと込み</h2>
          <p style="font-size:17px; line-height:1.6; color:#5a7488; margin:0;">韓国のクリニックに直接予約すると、正規料金を支払い、すべてをご自身で手配する必要があります。アリアコーポレーションを通せば、交渉済みの特別料金でご利用いただけ、航空券・ホテル・空港送迎まで含まれます。</p>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:24px; align-items:stretch;">

        
          <div style="background:#f7fbfd; border:1px solid #e1edf3; border-radius:24px; padding:clamp(26px,3vw,38px); display:flex; flex-direction:column;">
            <div style="font-size:13px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:#5a7488; margin-bottom:26px;">施術費用の比較</div>

          
            <div style="margin-bottom:24px;">
              <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:9px;">
                <span style="font-size:14.5px; font-weight:600; color:#5a7488;">クリニック直接予約の価格</span>
                <span style="font-family:'Zen Kaku Gothic New',sans-serif; font-size:15px; font-weight:700; color:#7d99a8;">100%</span>
              </div>
              <div style="height:46px; border-radius:12px; background:#d3dfe7; display:flex; align-items:center; padding:0 16px;">
                <span style="font-size:13px; font-weight:600; color:#5a7488;">正規料金・すべて自己手配</span>
              </div>
            </div>

          
            <div>
              <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:9px;">
                <span style="font-size:14.5px; font-weight:700; color:#122a3a;">アリアコーポレーション利用時</span>
                <span style="font-family:'Zen Kaku Gothic New',sans-serif; font-size:15px; font-weight:700; color:var(--accent);">最大&minus;40%</span>
              </div>
              <div style="position:relative; height:46px;">
                <div style="position:absolute; inset:0; border-radius:12px; background:repeating-linear-gradient(135deg,#eef4f7 0 9px,#f7fbfd 9px 18px); border:1px dashed #cdd9e1;"></div>
                <div style="position:relative; width:60%; height:46px; border-radius:12px; background:linear-gradient(90deg,#FF7A4D,#ee6537); display:flex; align-items:center; padding:0 16px; box-shadow:0 12px 24px -12px rgba(255,122,77,.8);">
                  <span style="font-size:13px; font-weight:700; color:#fff;">交渉済み特別料金</span>
                </div>
              </div>
            </div>

            <div style="margin-top:28px; display:inline-flex; align-self:flex-start; align-items:center; gap:9px; background:#fff; border:1px solid #ffd9c9; border-radius:999px; padding:10px 16px;">
              <Icon name="trending-down" style="font-size:18px; color:var(--accent);" />
              <span style="font-size:14px; font-weight:700; color:#122a3a;">手術費用を最大<span style="color:var(--accent);">40%</span>節約</span>
            </div>
          </div>

        
          <div style="background:#0e2738; border-radius:24px; padding:clamp(26px,3vw,38px); display:flex; flex-direction:column; color:#fff;">
            <div style="font-size:13px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:#8fb3c4; margin-bottom:8px;">追加費用なしで含まれるもの</div>
            <div style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(20px,2vw,24px); line-height:1.25; margin-bottom:26px;">旅程すべてをカバーします</div>

            <div style="display:flex; flex-direction:column; gap:14px;">
              <div style="display:flex; align-items:center; gap:16px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:16px; padding:16px 18px;">
                <span style="flex:none; width:46px; height:46px; border-radius:13px; background:rgba(255,122,77,.16); display:flex; align-items:center; justify-content:center;"><Icon name="plane" style="font-size:22px; color:#ffb699;" /></span>
                <div>
                  <div style="font-weight:700; font-size:16px;">航空券</div>
                  <div style="font-size:13.5px; color:rgba(255,255,255,.66);">韓国への往復航空券を手配します。</div>
                </div>
                <Icon name="check" style="margin-left:auto; font-size:20px; color:#7fd6a6;" />
              </div>

              <div style="display:flex; align-items:center; gap:16px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:16px; padding:16px 18px;">
                <span style="flex:none; width:46px; height:46px; border-radius:13px; background:rgba(255,122,77,.16); display:flex; align-items:center; justify-content:center;"><Icon name="bed-double" style="font-size:22px; color:#ffb699;" /></span>
                <div>
                  <div style="font-weight:700; font-size:16px;">宿泊施設</div>
                  <div style="font-size:13.5px; color:rgba(255,255,255,.66);">クリニック近くの、回復に適したホテルをご用意。</div>
                </div>
                <Icon name="check" style="margin-left:auto; font-size:20px; color:#7fd6a6;" />
              </div>

              <div style="display:flex; align-items:center; gap:16px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:16px; padding:16px 18px;">
                <span style="flex:none; width:46px; height:46px; border-radius:13px; background:rgba(255,122,77,.16); display:flex; align-items:center; justify-content:center;"><Icon name="car-front" style="font-size:22px; color:#ffb699;" /></span>
                <div>
                  <div style="font-weight:700; font-size:16px;">空港送迎</div>
                  <div style="font-size:13.5px; color:rgba(255,255,255,.66);">ドアツードアの専用送迎です。</div>
                </div>
                <Icon name="check" style="margin-left:auto; font-size:20px; color:#7fd6a6;" />
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

  
    <section style="position:relative; background:#0e2738 url('/assets/how-it-works-street.png') center / cover no-repeat; padding:clamp(64px,8vw,104px) clamp(24px,5vw,72px); overflow:hidden;">
      <div style="position:absolute; inset:0; background:linear-gradient(180deg,rgba(8,22,33,.82) 0%,rgba(8,22,33,.74) 50%,rgba(8,22,33,.86) 100%);"></div>
      <div style="position:relative; max-width:1320px; margin:0 auto;">
        <div style="text-align:center; max-width:680px; margin:0 auto 56px;">
          <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#7fd0e6; margin-bottom:14px;">フルコンシェルジュならではの違い</div>
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(30px,3.6vw,44px); line-height:1.1; letter-spacing:-.02em; margin:0 0 14px; color:#fff;">ご利用の流れ</h2>
          <p style="font-size:17px; line-height:1.6; color:rgba(255,255,255,.82); margin:0;">病院に直接予約すると、すべてをご自身で管理する必要があります。私たちが旅の全行程に寄り添います。</p>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:22px;">
          {steps.map((st) => (<>
            <div class="lift" style="background:#fff; border:1px solid #e1edf3; border-radius:22px; padding:30px 26px; box-shadow:0 1px 2px rgba(16,41,61,.04);">
              <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
                <div style="width:50px; height:50px; border-radius:14px; background:#eaf6fa; color:#2e9fc0; display:flex; align-items:center; justify-content:center; font-size:24px;">
                  <Icon name={st.icon} />
                </div>
                <span style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:34px; color:#e3eef4;">{st.no}</span>
              </div>
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:600; font-size:20px; margin:0 0 9px; color:#122a3a;">{st.title}</h3>
              <p style="font-size:14.5px; line-height:1.6; color:#5a7488; margin:0;">{st.body}</p>
            </div>
          </>))}
        </div>
      </div>
    </section>

  
    <section id="surgeries" data-screen-label="05 Surgeries" style="background:#fff; padding:clamp(64px,8vw,104px) clamp(24px,5vw,72px); border-top:1px solid #e1edf3;">
      <div style="max-width:1320px; margin:0 auto;">
        <div style="display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:48px;">
          <div style="max-width:620px;">
            <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#2e9fc0; margin-bottom:14px;">施術・手術一覧</div>
            <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(30px,3.6vw,44px); line-height:1.1; letter-spacing:-.02em; margin:0 0 14px;">カテゴリーから探す</h2>
            <p style="font-size:17px; line-height:1.6; color:#5a7488; margin:0;">各カテゴリーには、施術内容・価格帯・よくある質問・関連ガイドをまとめた専用ページがあります。</p>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:20px;">
          {surgeries.map((c) => (<>
            <a href={`/surgeries/${c.slug}/`} class="lift" style="display:flex; flex-direction:column; background:#fff; border:1px solid #e1edf3; border-radius:22px; overflow:hidden; box-shadow:0 1px 2px rgba(16,41,61,.04);">
              <div style="height:150px; overflow:hidden; background:#dce8ee;"><Fragment set:html={c.imgEl} /></div>
              <div style="padding:24px 24px 26px; display:flex; flex-direction:column; flex:1;">
                <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:600; font-size:20px; margin:0 0 8px; color:#122a3a;">{c.name}</h3>
                <p style="font-size:14px; line-height:1.55; color:#5a7488; margin:0 0 16px;">{c.desc}</p>
                <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px;">
                  {c.tags.map((t) => (<>
                    <span style="font-size:12.5px; font-weight:600; color:#3f6075; background:#f0f6f9; border:1px solid #e1edf3; padding:6px 11px; border-radius:999px;">{t}</span>
                  </>))}
                </div>
                <div style="margin-top:auto; display:inline-flex; align-items:center; gap:7px; color:var(--accent); font-weight:700; font-size:14.5px;">
                  {c.more} <Icon name="arrow-right" style="font-size:17px;" />
                </div>
              </div>
            </a>
          </>))}
        </div>
      </div>
    </section>

  
    <section id="services" data-screen-label="06 Concierge Services" style="position:relative; background:#0e2738 url('/assets/concierge-bg.png') center / cover no-repeat; color:#fff; padding:clamp(64px,8vw,104px) clamp(24px,5vw,72px); overflow:hidden;">
      <div style="position:absolute; inset:0; background:linear-gradient(160deg,rgba(16,58,78,.86) 0%,rgba(14,39,56,.9) 100%);"></div>
      <div style="position:relative; max-width:1320px; margin:0 auto;">
        <div style="text-align:center; max-width:680px; margin:0 auto 56px;">
          <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#7fd0e6; margin-bottom:14px;">コンシェルジュサービス</div>
          <h2 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:700; font-size:clamp(30px,3.6vw,44px); line-height:1.1; letter-spacing:-.02em; margin:0 0 14px;">すべてをまるごとサポート</h2>
          <p style="font-size:17px; line-height:1.6; color:rgba(255,255,255,.8); margin:0;">個人で病院を直接予約する場合との大きな違いがここにあります。</p>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:18px;">
          {services.map((v) => (<>
            <div class="lift" style="background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:20px; padding:28px 26px;">
              <div style="width:52px; height:52px; border-radius:15px; background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center; font-size:24px; margin-bottom:20px; box-shadow:0 12px 26px -12px rgba(255,122,77,.9);">
                <Icon name={v.icon} />
              </div>
              <h3 style="font-family:'Zen Kaku Gothic New',sans-serif; font-weight:600; font-size:19px; margin:0 0 9px;">{v.title}</h3>
              <p style="font-size:14.5px; line-height:1.6; color:rgba(255,255,255,.74); margin:0;">{v.body}</p>
            </div>
          </>))}
        </div>
      </div>
    </section>

  
    <section style="background:#fff; padding:clamp(64px,8vw,104px) clamp(24px,5vw,72px); border-top:1px solid #e1edf3;">
      <div style="max-width:1320px; margin:0 auto;">
        <div style="text-align:center; max-width:640px; margin:0 auto 52px;">
          <div style="font:700 13px/1 'Noto Sans JP'; letter-spacing:.14em; text-transform:uppercase; color:#2e9fc0; margin-bottom:14px;">患者様の声</div>
