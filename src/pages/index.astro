<script>
  // Event popup banner: shown on load unless "今日は表示しない" was ticked earlier today.
  const popup = document.getElementById('event-popup');
  if (popup) {
    const KEY = 'aria_event_popup_hide_until';
    let hideToday = false;
    let show = true;
    try {
      if (localStorage.getItem(KEY) === new Date().toDateString()) show = false;
    } catch (e) {}
    if (show) popup.hidden = false;
    popup.querySelector('[data-popup-hide-today]')?.addEventListener('change', (e) => {
      hideToday = (e.target as HTMLInputElement).checked;
    });
    popup.querySelectorAll('[data-popup-close]').forEach((btn) =>
      btn.addEventListener('click', () => {
        if (hideToday) {
          try {
            localStorage.setItem(KEY, new Date().toDateString());
          } catch (e) {}
        }
        popup.hidden = true;
      }),
    );
  }
</script>
